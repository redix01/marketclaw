{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "onboardingCompleted": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "Account": {
      "title": "Account",
      "description": "Virtual brokerage account state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "cashBalance": { "type": "number" },
        "totalDeposits": { "type": "number" },
        "totalWithdrawals": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "cashBalance"]
    },
    "Position": {
      "title": "Position",
      "description": "Current asset holding",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "symbol": { "type": "string" },
        "assetType": { "type": "string", "enum": ["stock", "crypto"] },
        "quantity": { "type": "number" },
        "averageEntryPrice": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "symbol", "quantity", "averageEntryPrice"]
    },
    "Order": {
      "title": "Order",
      "description": "Trade order record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "symbol": { "type": "string" },
        "side": { "type": "string", "enum": ["buy", "sell"] },
        "quantity": { "type": "number" },
        "orderType": { "type": "string", "enum": ["market"] },
        "status": { "type": "string", "enum": ["pending", "filled", "cancelled", "rejected"] },
        "source": { "type": "string", "enum": ["manual", "bot"] },
        "agentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "filledAt": { "type": "string", "format": "date-time" },
        "fillPrice": { "type": "number" }
      },
      "required": ["uid", "symbol", "side", "quantity", "status", "source", "createdAt"]
    },
    "LedgerEvent": {
      "title": "LedgerEvent",
      "description": "Cash movement record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "trade_buy", "trade_sell", "adjustment"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "referenceId": { "type": "string" }
      },
      "required": ["uid", "type", "amount", "timestamp"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Agentic trading bot configuration",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "template": { "type": "string" },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["running", "stopped", "paused", "blocked"] },
        "maxAllocation": { "type": "number" },
        "maxPositionSize": { "type": "number" },
        "tickFrequency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastTickAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "status", "createdAt"]
    },
    "AgentLog": {
      "title": "AgentLog",
      "description": "Agent decision and activity logs",
      "type": "object",
      "properties": {
        "agentId": { "type": "string" },
        "uid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventType": { "type": "string", "enum": ["tick", "decision", "risk_block", "order_submitted", "error"] },
        "symbol": { "type": "string" },
        "summary": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["agentId", "uid", "timestamp", "eventType"]
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "accounts/{uid}": {
      "schema": "Account",
      "description": "User virtual accounts"
    },
    "positions/{positionId}": {
      "schema": "Position",
      "description": "Current holdings (positionId could be uid_symbol)"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Trade orders"
    },
    "ledger/{eventId}": {
      "schema": "LedgerEvent",
      "description": "Account ledger"
    },
    "agents/{agentId}": {
      "schema": "Agent",
      "description": "Trading bots"
    },
    "agentLogs/{logId}": {
      "schema": "AgentLog",
      "description": "Bot activity logs"
    }
  }
}
