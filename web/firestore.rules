rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, photoURL, createdAt, onboardingCompleted
    //
    // Collection: accounts
    // Fields: uid, cashBalance, totalDeposits, totalWithdrawals, updatedAt
    //
    // Collection: positions
    // Fields: uid, symbol, assetType, quantity, averageEntryPrice, updatedAt
    //
    // Collection: orders
    // Fields: uid, symbol, side, quantity, orderType, status, source, agentId, createdAt, filledAt, fillPrice
    //
    // Collection: ledger
    // Fields: uid, type, amount, description, timestamp, referenceId
    //
    // Collection: agents
    // Fields: uid, name, template, symbols, status, maxAllocation, maxPositionSize, tickFrequency, createdAt, lastTickAt
    //
    // Collection: agentLogs
    // Fields: agentId, uid, timestamp, eventType, symbol, summary, details
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function incomingDocOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "emmagab38@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.createdAt is string;
    }

    function isValidAccount(data) {
      return data.uid is string &&
             data.cashBalance is number &&
             data.cashBalance >= 0;
    }

    function isValidPosition(data) {
      return data.uid is string &&
             data.symbol is string &&
             data.quantity is number &&
             data.averageEntryPrice is number;
    }

    function isValidOrder(data) {
      return data.uid is string &&
             data.symbol is string &&
             data.side in ['buy', 'sell'] &&
             data.quantity is number &&
             data.status in ['pending', 'filled', 'cancelled', 'rejected'] &&
             data.source in ['manual', 'bot'];
    }

    function isValidAgent(data) {
      return data.uid is string &&
             data.name is string &&
             data.status in ['running', 'stopped', 'paused', 'blocked'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /accounts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidAccount(request.resource.data);
      allow update: if isOwner(userId) && isValidAccount(request.resource.data);
    }

    match /positions/{positionId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if incomingDocOwner() && isValidPosition(request.resource.data);
      allow update: if isDocOwner() && incomingDocOwner() && isValidPosition(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /orders/{orderId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if incomingDocOwner() && isValidOrder(request.resource.data);
      allow update: if isDocOwner() && incomingDocOwner() && isValidOrder(request.resource.data);
    }

    match /ledger/{eventId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if incomingDocOwner();
    }

    match /agents/{agentId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if incomingDocOwner() && isValidAgent(request.resource.data);
      allow update: if isDocOwner() && incomingDocOwner() && isValidAgent(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /agentLogs/{logId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if incomingDocOwner();
    }
  }
}
